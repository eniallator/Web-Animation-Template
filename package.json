{
  "author": "eniallator",
  "description": "Boilerplate for my web animations",
  "engines": {
    "node": ">=25.4.0"
  },
  "license": "MIT",
  "name": "web-animation-template",
  "packageManager": "pnpm@11.20.0",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "1.0.0",
  "dependencies": {
    "deep-guards": "^1.4.0",
    "method-monitor": "^1.0.0",
    "niall-utils": "^2.0.1",
    "seriform": "^1.3.1",
    "vectyped": "^1.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "babel-loader": "^10.1.1",
    "browser-sync": "^3.0.4",
    "browser-sync-webpack-plugin": "^2.4.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ./src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "findissues": "pnpm typecheck && pnpm lint && pnpm format:check",
    "prepublish": "pnpm build && pnpm findissues",
    "test": "vitest run --config vitest.config.js"
  }
}
